# Normalize line endings: LF in the repo, native in checkouts.
* text=auto eol=lf

# Windows scripts should stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary-ish assets (none today, but future-proof).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary